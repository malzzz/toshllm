+// wave64 single-token decode variant: one 64-thread wave per (d_inner row, head, seq), each
+// lane owns d_state/64 state slots (2 at d_state=128). The generic kernel's multi-token
+// shared precompute (shared x_dt/dA + 3 barriers) is dead weight at n_t == 1; here dt/x_dt/dA
+// are computed per lane (all L1-cached scalars) and one simd_sum finishes the reduction.
+kernel void kernel_ssm_scan_f32_dec(
+        constant ggml_metal_kargs_ssm_scan & args,
+        device const void * src0,
+        device const void * src1,
+        device const void * src2,
+        device const void * src3,
+        device const void * src4,
+        device const void * src5,
+        device const void * src6,
+        device      float * dst,
+        ushort  tiisg [[thread_index_in_simdgroup]],
+        uint3   tgpig [[threadgroup_position_in_grid]]) {
+    const int32_t i0 = tiisg;    // d_state lane; lane also owns i0 + 64
+    const int32_t i1 = tgpig.x;  // d_inner row
+    const int32_t ir = tgpig.y;  // head
+    const int32_t i3 = tgpig.z;  // seq
+
+    const int32_t nc = args.d_state;   // == 2*64 on this path
+    const int32_t nr = args.d_inner;
+    const int32_t nh = args.n_head;
+    const int32_t ng = args.n_group;
+
+    const int32_t g = ir / (nh / ng); // repeat_interleave
+
+    device const int32_t * ids = (device const int32_t *) src6;
+
+    device       float * s_buff  = (device       float *) ((device       char *) dst  + ir*args.nb02 +        i3*args.nb03 + args.s_off);
+    device const float * s0_buff = (device const float *) ((device const char *) src0 + ir*args.nb02 + ids[i3]*args.nb03);
+
+    device const float * A  = (device const float *) ((device const char *) src3 + ir*args.nb31);
+    device const float * x  = (device const float *) ((device const char *) src1 + i1*args.nb10 + ir*args.nb11 + i3*args.nb13);
+    device const float * dt = (device const float *) ((device const char *) src2 + ir*args.nb20 + i3*args.nb22);
+    device const float * B  = (device const float *) ((device const char *) src4 + g*args.nb41 + i3*args.nb43);
+    device const float * C  = (device const float *) ((device const char *) src5 + g*args.nb51 + i3*args.nb53);
+
+    const float dt0  = dt[0];
+    const float dtsp = dt0 <= 20.0f ? log(1.0f + exp(dt0)) : dt0;
+    const float x_dt = x[0] * dtsp;
+
+    float acc = 0.0f;
+    for (int k = 0; k < 2; ++k) {
+        const int32_t i0k = i0 + k*64;
+        const int32_t ik  = i0k + i1*nc;
+        const float   dAk = exp(dtsp * A[i0k % args.ne30]);
+
+        const float sk = s0_buff[ik] * dAk + B[i0k] * x_dt;
+        s_buff[ik]  = sk;
+        acc        += sk * C[i0k];
+    }
+
+    const float sumf = simd_sum(acc);
+
+    if (tiisg == 0) {
+        dst[i1 + ir*nr + i3*(nh*nr)] = sumf; // t == 0
+    }
+}
