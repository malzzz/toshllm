 typedef decltype(kernel_gated_delta_net_impl<4>) kernel_gated_delta_net_t;
 
 template [[host_name("kernel_gated_delta_net_f32_1")]] kernel kernel_gated_delta_net_t kernel_gated_delta_net_impl<1>;
 template [[host_name("kernel_gated_delta_net_f32_2")]] kernel kernel_gated_delta_net_t kernel_gated_delta_net_impl<2>;
 template [[host_name("kernel_gated_delta_net_f32_4")]] kernel kernel_gated_delta_net_t kernel_gated_delta_net_impl<4>;
 
+// Aligned wave64 decode: each logical 32-lane group updates two state rows.
+kernel void kernel_gated_delta_net_f32_4_rows2(
+        constant ggml_metal_kargs_gated_delta_net & args,
+        device const char * q,
+        device const char * k,
+        device const char * v,
+        device const char * g,
+        device const char * b,
+        device const char * s,
+        device       char * dst,
+        uint3 tgpig[[threadgroup_position_in_grid]],
+        uint3 tpitg[[thread_position_in_threadgroup]],
+        uint3   ntg[[threads_per_threadgroup]]) {
+#define S_v FC_gated_delta_net_ne20
+#define G   FC_gated_delta_net_ne30
+#define K   FC_gated_delta_net_K
+    const uint tx = tpitg.x;
+    const uint i23 = tgpig.z;
+    const uint i21 = tgpig.y;
+    const uint i20 = tgpig.x*8 + tpitg.y;
+    const uint i01 = i21 % args.ne01;
+    const uint i11 = i21 % args.ne11;
+    const float scale = 1.0f / sqrt((float)S_v);
+
+    const uint state_base = (i23*args.ne21 + i21)*S_v*S_v + i20*S_v;
+    device const float * s_ptr = (device const float *) s + state_base;
+    float4 ls[2] = {
+        *(device const float4 *) (s_ptr + tx*4),
+        *(device const float4 *) (s_ptr + 4*S_v + tx*4),
+    };
+
+    device float * dst_attn = (device float *) dst + (i23*args.ne22*args.ne21 + i21)*S_v + i20;
+    device const float * q_ptr = (device const float *) (q + i23*args.nb03 + i01*args.nb01);
+    device const float * k_ptr = (device const float *) (k + i23*args.nb13 + i11*args.nb11);
+    device const float * v_ptr = (device const float *) (v + i23*args.nb23 + i21*args.nb21);
+    device const float * b_ptr = (device const float *) b + (i23*args.ne22*args.ne21 + i21);
+    device const float * g_ptr = (device const float *) g + (i23*args.ne22*args.ne21 + i21)*G;
+
+    const uint attn_size = args.ne22 * args.ne21 * S_v * args.ne23;
+    const uint state_size_per_snap = S_v * S_v * args.ne21 * args.ne23;
+
+    for (short t = 0; t < args.ne22; t++) {
+        float4 g_exp;
+        if (G == 1) {
+            g_exp = float4(exp(g_ptr[0]));
+        } else {
+            FOR_UNROLL (short j = 0; j < 4; j++) {
+                g_exp[j] = exp(g_ptr[tx*4 + j]);
+            }
+        }
+
+        const float4 k4 = *(device const float4 *) (k_ptr + tx*4);
+        const float beta = b_ptr[0];
+        float d[2];
+        FOR_UNROLL (short r = 0; r < 2; r++) {
+            float s_k = 0.0f;
+            FOR_UNROLL (short j = 0; j < 4; j++) {
+                ls[r][j] *= g_exp[j];
+            }
+            FOR_UNROLL (short j = 0; j < 4; j++) {
+                s_k += ls[r][j]*k4[j];
+            }
+            s_k = gdn_sum32(s_k);
+            d[r] = (v_ptr[i20 + r*4] - s_k)*beta;
+        }
+
+        const float4 q4 = *(device const float4 *) (q_ptr + tx*4);
+        FOR_UNROLL (short r = 0; r < 2; r++) {
+            float y = 0.0f;
+            FOR_UNROLL (short j = 0; j < 4; j++) {
+                ls[r][j] += k4[j]*d[r];
+                y += ls[r][j]*q4[j];
+            }
+            y = gdn_sum32(y);
+            if (tx == 0) {
+                dst_attn[t*args.ne21*S_v + r*4] = y*scale;
+            }
+        }
+
+        q_ptr += args.ns02;
+        k_ptr += args.ns12;
+        v_ptr += args.ns22;
+        b_ptr += args.ne21;
+        g_ptr += args.ne21*G;
+
+        if (K > 1) {
+            const int target_slot = (int)args.ne22 - 1 - (int)t;
+            if (target_slot >= 0 && target_slot < (int)K) {
+                device float * dst_state = (device float *) dst + attn_size + (uint)target_slot*state_size_per_snap + state_base;
+                FOR_UNROLL (short r = 0; r < 2; r++) {
+                    *(device float4 *) (dst_state + r*4*S_v + tx*4) = ls[r];
+                }
+            }
+        }
+    }
+
+    if (K == 1) {
+        device float * dst_state = (device float *) dst + attn_size + state_base;
+        FOR_UNROLL (short r = 0; r < 2; r++) {
+            *(device float4 *) (dst_state + r*4*S_v + tx*4) = ls[r];
+        }
+    }
+#undef S_v
+#undef G
+#undef K
+}
+
 #else
 // a simplified version of the above
 // no performance improvement, so keep the above version for now
 
