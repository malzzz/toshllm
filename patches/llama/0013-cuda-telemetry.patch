diff --git a/ggml/src/ggml-cuda/ggml-cuda-telemetry.cpp b/ggml/src/ggml-cuda/ggml-cuda-telemetry.cpp
new file mode 100644
index 000000000..7ed8f4b78
--- /dev/null
+++ b/ggml/src/ggml-cuda/ggml-cuda-telemetry.cpp
@@ -0,0 +1,255 @@
+//
+// ggml-cuda-telemetry.cpp — C++ glue for the tosh-telemetry staticlib.
+// CUDA twin of ggml-metal-telemetry.m; compiled only with
+// GGML_CUDA_TELEMETRY=ON and linked against libmxp_telemetry.a.
+// Runtime-API only (no device code), so this builds as plain C++.
+
+#include "ggml-cuda-telemetry.h"
+
+#include <cuda_runtime.h>
+
+#include <mutex>
+#include <stdio.h>
+#include <string>
+#include <string.h>
+
+#define TT_STR2(x) #x
+#define TT_STR(x) TT_STR2(x)
+
+// ---------------------------------------------------------------------------
+// device registry: ggml slot -> physical CUDA ordinal. Populated serially
+// during backend registration (ggml_backend_cuda_reg), then read-only.
+
+#define TT_MAX_DEV 16
+
+static int s_phys[TT_MAX_DEV];
+static int s_dev_n = 0;
+
+void tosh_tele_cuda_device_init(int slot, int physical_cuda_device) {
+    tosh_tele_init(); // idempotent; fixes the mode word
+
+    if (slot >= 0 && slot < TT_MAX_DEV) {
+        s_phys[slot] = physical_cuda_device;
+        if (slot + 1 > s_dev_n) {
+            s_dev_n = slot + 1;
+        }
+    }
+
+    if (__atomic_load_n(&tosh_tele_g_mode, __ATOMIC_RELAXED) == 0) {
+        return;
+    }
+
+    static bool s_manifest_done = false;
+    if (s_manifest_done) {
+        return;
+    }
+    s_manifest_done = true;
+
+    // full physical device inventory for the manifest
+    {
+        int n = 0;
+        if (cudaGetDeviceCount(&n) != cudaSuccess) {
+            n = 0;
+        }
+        std::string js = "[";
+        for (int i = 0; i < n; ++i) {
+            cudaDeviceProp prop;
+            if (cudaGetDeviceProperties(&prop, i) != cudaSuccess) {
+                continue;
+            }
+            char pci[64] = {};
+            cudaDeviceGetPCIBusId(pci, sizeof(pci), i);
+            int slot_of = -1;
+            for (int k = 0; k < s_dev_n; ++k) {
+                if (s_phys[k] == i) {
+                    slot_of = k;
+                    break;
+                }
+            }
+            char ent[1024];
+            snprintf(ent, sizeof(ent),
+                "%s{\"name\":\"%s\",\"pci_bus_id\":\"%s\",\"compute_capability\":\"%d.%d\","
+                "\"total_mem\":%llu,\"sm_count\":%d,\"ggml_slot\":%d}",
+                i > 0 ? "," : "", prop.name, pci, prop.major, prop.minor,
+                (unsigned long long) prop.totalGlobalMem, prop.multiProcessorCount, slot_of);
+            js += ent;
+        }
+        js += "]";
+        tosh_tele_set_devices_json(js.c_str());
+    }
+
+    // backend stamp: the core emits "backend":"unknown" unless glue overrides it
+    tosh_tele_manifest_set_field("backend", "\"cuda\"");
+
+    // build stamps
+    {
+#ifdef GGML_CUDA_TELEMETRY_NVCC_VERSION
+        const char * nvcc_ver = GGML_CUDA_TELEMETRY_NVCC_VERSION;
+#else
+        const char * nvcc_ver = "unknown";
+#endif
+#ifdef TOSH_VERSION
+        const char * tosh_ver = TT_STR(TOSH_VERSION);
+#else
+        const char * tosh_ver = "unknown";
+#endif
+#ifdef TOSH_GIT_COMMIT
+        const char * tosh_commit = TT_STR(TOSH_GIT_COMMIT);
+#else
+        const char * tosh_commit = "unknown";
+#endif
+#ifdef TOSH_GIT_DIRTY
+        const char * tosh_dirty = TT_STR(TOSH_GIT_DIRTY);
+#else
+        const char * tosh_dirty = "0";
+#endif
+#ifdef TOSH_LLAMA_COMMIT
+        const char * llama_commit = TT_STR(TOSH_LLAMA_COMMIT);
+#else
+        const char * llama_commit = "unknown";
+#endif
+        int rt = 0;
+        cudaRuntimeGetVersion(&rt);
+        char buf[1024];
+        snprintf(buf, sizeof(buf),
+            "{\"cudart_compile\":%d,\"cudart_runtime\":%d,\"nvcc\":\"%s\",\"tosh_version\":\"%s\","
+            "\"toshllm_commit\":\"%s\",\"toshllm_dirty\":%s,\"llama_commit\":\"%s\"}",
+            (int) CUDART_VERSION, rt, nvcc_ver, tosh_ver, tosh_commit, tosh_dirty, llama_commit);
+        tosh_tele_manifest_set_field("build", buf);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// command-buffer GPU timing: per-device pool of preallocated cudaEvent pairs.
+// cb_begin records ev0 on the launch stream (host anchor sampled just before),
+// cb_end records ev1, resolve converts the elapsed time to host-anchored
+// gpu_start/gpu_end once the stream has passed ev1. See the header for why
+// this approximates (not equals) Metal's absolute GPU timestamps.
+
+#define TT_POOL 32
+
+struct tt_cb {
+    cudaEvent_t  ev0;       // begin (timing enabled); NULL until first use
+    cudaEvent_t  ev1;       // end
+    cudaStream_t stream;
+    uint64_t     graph;
+    uint32_t     cb_idx;
+    uint64_t     anchor_ns; // host ns sampled just before the ev0 record
+    int          state;     // 0 = free, 1 = claimed (awaiting cb_end), 2 = pending resolve
+};
+
+static tt_cb       s_pool[TT_MAX_DEV][TT_POOL];
+static std::mutex  s_pool_mu;
+
+// caller holds s_pool_mu
+static void resolve_locked(int device) {
+    for (int i = 0; i < TT_POOL; ++i) {
+        tt_cb & s = s_pool[device][i];
+        if (s.state != 2) {
+            continue;
+        }
+        if (cudaEventQuery(s.ev1) != cudaSuccess) {
+            continue; // stream has not passed the end record yet
+        }
+        float ms = 0.0f;
+        const bool ok = cudaEventElapsedTime(&ms, s.ev0, s.ev1) == cudaSuccess;
+        // kernel timestamps unavailable (flags bit0); gpu ts zeroed on error (bit1)
+        const uint64_t gpu_start = ok ? s.anchor_ns : 0;
+        const uint64_t gpu_end   = ok ? s.anchor_ns + (uint64_t) (ms * 1e6) : 0;
+        tosh_tele_cb_gpu((uint32_t) device, s.graph, s.cb_idx,
+                         0, 0, gpu_start, gpu_end, tosh_tele_uptime_ns());
+        s.state = 0;
+    }
+}
+
+uint64_t tosh_tele_cuda_cb_begin(int device, void * stream, uint64_t graph, uint32_t cb_idx) {
+    if (device < 0 || device >= TT_MAX_DEV) {
+        return 0;
+    }
+    std::lock_guard<std::mutex> lock(s_pool_mu);
+    resolve_locked(device); // recycle completed pairs before claiming a slot
+    for (int i = 0; i < TT_POOL; ++i) {
+        tt_cb & s = s_pool[device][i];
+        if (s.state != 0) {
+            continue;
+        }
+        if (s.ev0 == nullptr) {
+            if (cudaEventCreate(&s.ev0) != cudaSuccess || cudaEventCreate(&s.ev1) != cudaSuccess) {
+                return 0;
+            }
+        }
+        s.stream    = (cudaStream_t) stream;
+        s.graph     = graph;
+        s.cb_idx    = cb_idx;
+        s.anchor_ns = tosh_tele_uptime_ns();
+        if (cudaEventRecord(s.ev0, s.stream) != cudaSuccess) {
+            return 0;
+        }
+        s.state = 1;
+        return ((uint64_t) (uint32_t) device << 32) | (uint32_t) (i + 1);
+    }
+    return 0; // pool exhausted: cb_gpu dropped for this CB
+}
+
+void tosh_tele_cuda_cb_end(uint64_t ticket) {
+    if (ticket == 0) {
+        return;
+    }
+    const int device = (int) (ticket >> 32);
+    const int idx    = (int) (ticket & 0xffffffffu) - 1;
+    std::lock_guard<std::mutex> lock(s_pool_mu);
+    tt_cb & s = s_pool[device][idx];
+    if (s.state != 1) {
+        return;
+    }
+    if (cudaEventRecord(s.ev1, s.stream) != cudaSuccess) {
+        s.state = 0;
+        return;
+    }
+    s.state = 2;
+}
+
+void tosh_tele_cuda_cb_resolve(int device) {
+    if (device < 0 || device >= TT_MAX_DEV) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(s_pool_mu);
+    resolve_locked(device);
+}
+
+// ---------------------------------------------------------------------------
+// dispatch hook: per-node, op-name hash cached after first registration.
+// Grid/block dims are unavailable at this granularity (see header).
+
+#define TT_MAX_NAMES 256
+
+struct tt_name {
+    const char * name; // ggml_op_name strings are static
+    uint64_t     hash;
+};
+
+static tt_name    s_names[TT_MAX_NAMES];
+static int        s_names_n = 0;
+static std::mutex s_names_mu;
+
+void tosh_tele_cuda_dispatch(int device, const char * op_name, unsigned mode) {
+    if (mode < 2) {
+        tosh_tele_dispatch((uint32_t) device, 0, 0, 0, 0, 0, 0, 0);
+        return;
+    }
+    uint64_t h = 0;
+    {
+        std::lock_guard<std::mutex> lock(s_names_mu);
+        for (int i = 0; i < s_names_n; ++i) {
+            if (strcmp(s_names[i].name, op_name) == 0) {
+                h = s_names[i].hash;
+                break;
+            }
+        }
+        if (h == 0 && s_names_n < TT_MAX_NAMES) {
+            h = tosh_tele_name_register((const uint8_t *) op_name, (uint32_t) strlen(op_name));
+            s_names[s_names_n++] = { op_name, h };
+        }
+    }
+    tosh_tele_dispatch((uint32_t) device, h, 0, 0, 0, 0, 0, 0);
+}
diff --git a/ggml/src/ggml-cuda/ggml-cuda-telemetry.h b/ggml/src/ggml-cuda/ggml-cuda-telemetry.h
new file mode 100644
index 000000000..72cb7365f
--- /dev/null
+++ b/ggml/src/ggml-cuda/ggml-cuda-telemetry.h
@@ -0,0 +1,111 @@
+//
+// ggml-cuda-telemetry.h — glue between ggml-cuda and the tosh-telemetry
+// Rust staticlib (Phase-3; CUDA twin of ggml-metal-telemetry.h). Compiled
+// only with GGML_CUDA_TELEMETRY; every call site degenerates to one load +
+// one branch on tosh_tele_g_mode when telemetry is built in but disabled
+// via env.
+//
+// CUDA analogs of the Metal hook semantics (llama.cpp pin 3dc7285b):
+//
+// - "Command buffer" = one graph's batch of kernel launches on the backend's
+//   main stream (ggml_backend_cuda_graph_compute emits exactly one CB per
+//   graph, n_cb = 1). cb_cpu carries host t_begin/t_end/t_commit around the
+//   launch batch, same as Metal.
+// - cb_gpu: the batch is bracketed by a pair of cudaEvents (from a
+//   preallocated per-device pool — no cudaEventCreate on the hot path)
+//   recorded on the same stream, resolved after the backend's synchronize
+//   (or opportunistically on the next cb_begin). CUDA events yield only the
+//   elapsed time between the two records, so gpu_start/gpu_end are that
+//   delta anchored to the host clock (CLOCK_MONOTONIC_RAW ns) sampled just
+//   before the begin-record — an approximation of Metal's absolute
+//   GPUStartTime/EndTime. kernel_start/kernel_end are emitted as 0 (core
+//   sets flags bit0): per-dispatch GPU time is unavailable without CUPTI
+//   (future work).
+// - dispatch: ggml-cuda has no single kernel-launch choke point (each op
+//   launches via <<<>>> in its own .cu file), so the hook sits at the
+//   per-node dispatch site (ggml_cuda_compute_forward) and records the FNV-1a
+//   hash of the ggml op name. Grid/block dims are emitted as 0 — unavailable
+//   at node granularity (CUPTI, future).
+// - blit kinds (same numbering as the Metal patch):
+//     1 set_tensor       buffer + backend set_tensor(2d)(async) H2D copies
+//     2 get_tensor       buffer + backend get_tensor(2d)(async) D2H copies
+//     3 cpy_same_dev     backend cpy_tensor_async, same-backend D2D
+//     4 cpy_xdev_peer    backend cpy_tensor_async, cross-backend copy
+//                        (paired with EV kind 1 signal/wait on copy_event)
+//     5 cpy_xdev_events  NO CUDA ANALOG at this pin — the single xdev path
+//                        above already covers it; kind never emitted
+//     6 stage_set        Metal-specific staging fast path; no analog, omitted
+//     7 buffer_cpy_tensor buffer-iface cpy_tensor (same-physical D2D and
+//                        cudaMemcpyPeerAsync branches both land here)
+//   For kinds 4 and 7, p1 carries the peer ggml device slot (Metal passed 0).
+// - events: kind 0 = ggml backend event iface (event_record/event_wait),
+//   kind 1 = xdev_link (copy_event record/wait in cpy_tensor_async).
+//   cudaEvents carry no sequence value, so the event value is always 0.
+//   Kind 2 (peer_wait, Metal encodeWaitForEvent loop) has no analog, omitted.
+// - device registry: ggml device slot == the (virtual) CUDA device ordinal,
+//   so no pointer map is needed; the manifest maps slots to physical GPUs.
+
+#pragma once
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// -- direct Rust exports (libmxp_telemetry.a) ------------------------------
+
+// mode word: 0 = off, 1 = token mode, 2 = + per-dispatch metadata.
+// Set once by tosh_tele_init(); read on hot paths with __atomic_load_n
+// (declared as a plain word here; the core side is _Atomic, same ABI).
+extern unsigned int tosh_tele_g_mode;
+
+void     tosh_tele_init(void);
+unsigned tosh_tele_mode(void);
+void     tosh_tele_flush(void);
+uint64_t tosh_tele_uptime_ns(void);
+
+uint64_t tosh_tele_graph_begin(uint32_t device, uint64_t n_nodes);
+void     tosh_tele_graph_end(uint32_t device, uint64_t ordinal, uint64_t n_nodes, uint32_t n_cb, uint32_t flags);
+uint64_t tosh_tele_current_graph(uint32_t device);
+
+void tosh_tele_cb_cpu(uint32_t device, uint64_t graph, uint32_t cb_idx, uint32_t n_cb,
+                      uint64_t t_begin_ns, uint64_t t_end_ns, uint64_t t_commit_ns);
+void tosh_tele_cb_gpu(uint32_t device, uint64_t graph, uint32_t cb_idx,
+                      uint64_t kernel_start_ns, uint64_t kernel_end_ns,
+                      uint64_t gpu_start_ns, uint64_t gpu_end_ns, uint64_t host_done_ns);
+
+uint64_t tosh_tele_name_register(const uint8_t * name, uint32_t name_len);
+void tosh_tele_dispatch(uint32_t device, uint64_t name_hash,
+                        uint64_t tg0, uint64_t tg1, uint64_t tg2,
+                        uint64_t tptg0, uint64_t tptg1, uint64_t tptg2);
+void tosh_tele_blit(uint32_t device, uint32_t kind, uint64_t nbytes, uint32_t dst_device);
+void tosh_tele_ev(uint32_t device, uint32_t kind, uint32_t is_signal, uint64_t value);
+
+void tosh_tele_set_devices_json(const char * json);
+void tosh_tele_manifest_set_field(const char * key, const char * json);
+
+// -- CUDA glue (implemented in ggml-cuda-telemetry.cpp) ---------------------
+
+// register a ggml device slot and (once per process) hand the manifest the
+// full device inventory + build stamps; calls tosh_tele_init()
+void tosh_tele_cuda_device_init(int slot, int physical_cuda_device);
+
+// bracket one launch batch (one "command buffer") on a stream with a timing
+// event pair from the per-device pool. cb_begin records the begin event and
+// returns a ticket (0 = pool exhausted, cb_gpu dropped for this CB); cb_end
+// records the end event and queues the pair for resolution.
+uint64_t tosh_tele_cuda_cb_begin(int device, void * stream, uint64_t graph, uint32_t cb_idx);
+void     tosh_tele_cuda_cb_end(uint64_t ticket);
+
+// drain completed event pairs for a device, emitting tosh_tele_cb_gpu.
+// Called from the backend synchronize hook (and internally from cb_begin).
+void tosh_tele_cuda_cb_resolve(int device);
+
+// count (mode 1) or record (mode 2) one node dispatch; op_name is registered
+// once via tosh_tele_name_register (cached here)
+void tosh_tele_cuda_dispatch(int device, const char * op_name, unsigned mode);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 2456f7dcc..0651ce659 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
