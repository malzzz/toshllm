         return int(eos)
 
+    @classmethod
+    def filter_tensors(cls, item):
+        name, gen = item
+        if name.startswith("model.mtp."):
+            name = name.replace("model.", "", 1)
+        if name.startswith("mtp.") and not cls.no_mtp:
+            assert cls._original_block_count is not None
+            base = cls._original_block_count
+            if ".indexer." in name:
+                return None
+            parts = name.split(".")
+            # qwen4exp splits the fused eh_proj of the other hybrids into separate
+            # e/h projections, and its final HC mixer sits at the block output
+            if len(parts) == 3 and parts[1] in ("fc_embedding", "fc_hidden"):
+                return f"model.layers.{base}.{parts[1]}.{parts[2]}", gen
+            if len(parts) == 4 and parts[1] == "hyper_connection_mixer":
+                return f"model.layers.{base}.hc_mix.{parts[2]}.{parts[3]}", gen
+        return super().filter_tensors((name, gen))
+
     def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iterable[tuple[str, Tensor]]:
         # int64 hash constants must stay exact; 1-D tensors force F32, so use KV
         if name.endswith("ple_embedding.layer_multipliers"):
             self._ple_multipliers = [int(x) for x in data_torch.tolist()]
             return []
         if name.endswith("ple_embedding.ngram_heads_offsets"):
             self._ple_head_offsets = [int(x) for x in data_torch.tolist()]
             return []
