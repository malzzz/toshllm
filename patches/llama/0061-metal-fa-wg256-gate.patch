diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index 62b1433ad..86e2d24b3 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -4369,18 +4369,29 @@ int ggml_metal_op_flash_attn_ext(ggml_metal_op_t ctx, int idx) {
         static const int64_t wg_dk64_min_kv = []() {
             const char * s = getenv("TOSH_FA_WG_DK64");
             return s ? (int64_t) atoll(s) : (int64_t) 0;
         }();
         const bool wg_dk64 = ne00 == 64 && ne20 == 64 && wg_dk128_width_ok &&
                              wg_dk64_min_kv > 0 && ne11 >= wg_dk64_min_kv;
         const bool wg_dk128 = (ne00 == 128 && ne20 == 128 && wg_dk128_width_ok &&
                                wg_dk128_min_kv > 0 && ne11 >= wg_dk128_min_kv) || wg_dk64;
+        // wave64 dk256 with enough heads fills the CUs without the split: at 24 heads x
+        // ~2051 cells (qwen4exp QSA) the 32-way split measures 3x slower than the plain
+        // walk (the subw=32 halving plus the reduce pass buy nothing there). Few-head
+        // models and wave32 keep the split.
+        const bool wg_dk256_suppress = props_dev->simd_width == 64 && ne00 == 256 && ne02 >= 8;
+        // TOSH_FA_WG_NB_MAX=<n> extends the split to ne01 <= n (default 1): for testing
+        // small multi-token batches on deep caches
+        static const int64_t wg_nb_max = []() {
+            const char * s = getenv("TOSH_FA_WG_NB_MAX");
+            return s ? (int64_t) atoll(s) : (int64_t) 1;
+        }();
         const int fa_amd_nwg =
-            (wg_wide_head || wg_dk128) && ne01 == 1 && !has_sinks &&
+            (wg_wide_head || wg_dk128) && ne01 <= wg_nb_max && !has_sinks && !wg_dk256_suppress &&
             (props_dev->simd_width == 32 || props_dev->simd_width == 64) &&
             (wg_dk128 || ne11 >= 1024) &&
             getenv("TOSH_FA_WG_DISABLE") == NULL ? 32 : 1;
 
         char fa_amd_wg_pipeline[96];
         if (fa_amd_nwg > 1) {
             snprintf(fa_amd_wg_pipeline, sizeof(fa_amd_wg_pipeline), "%s_wg32", fa_amd_pipeline);
         }
