+// exchange-channel twin of ggml_metal_xdev_link_reserve: same layout, own buffers
+static bool ggml_metal_xdev_link_reserve_x(ggml_metal_t ctx_src, ggml_metal_t ctx_dst,
+                                           struct ggml_metal_xdev_link * link, size_t size) {
+    if (link->cap_x < size) {
+        // resizing frees pages a queued blit may still read; wait out the channel first
+        if (link->seq_x > 0 && ![link->ev_x_done waitUntilSignaledValue:link->seq_x timeoutMS:10000]) {
+            return false;
+        }
+        [link->wrap_x_src release];
+        [link->wrap_x_dst release];
+        free(link->host_x);
+        link->cap_x = MAX(size, (size_t) 1*1024*1024);
+        if (posix_memalign(&link->host_x, (size_t) sysconf(_SC_PAGESIZE), link->cap_x) != 0) {
+            link->host_x = NULL;
+            link->cap_x  = 0;
+            return false;
+        }
+        id<MTLDevice> dev_src = ggml_metal_device_get_obj(ctx_src->dev);
+        id<MTLDevice> dev_dst = ggml_metal_device_get_obj(ctx_dst->dev);
+        link->wrap_x_src = [dev_src newBufferWithBytesNoCopy:link->host_x
+                              length:link->cap_x options:MTLResourceStorageModeShared deallocator:nil];
+        link->wrap_x_dst = [dev_dst newBufferWithBytesNoCopy:link->host_x
+                              length:link->cap_x options:MTLResourceStorageModeShared deallocator:nil];
+        if (link->wrap_x_src == nil || link->wrap_x_dst == nil) {
+            // leaving cap_x set would make the next call skip this block and hand out the nil wraps
+            [link->wrap_x_src release];
+            [link->wrap_x_dst release];
+            link->wrap_x_src = nil;
+            link->wrap_x_dst = nil;
+            free(link->host_x);
+            link->host_x = NULL;
+            link->cap_x  = 0;
+            return false;
+        }
+    }
+    return true;
+}
 
