new file mode 100644
index 000000000..fc46014cd
--- /dev/null
+++ b/ggml/src/ggml-metal/ggml-metal-telemetry.h
@@ -0,0 +1,69 @@
+//
+// ggml-metal-telemetry.h — glue between ggml-metal and the tosh-telemetry
+// Rust staticlib (Phase-0 observability). Compiled only with
+// GGML_METAL_TELEMETRY; every call site degenerates to one load + one branch
+// on tosh_tele_g_mode when telemetry is built in but disabled via env.
+//
+
+#pragma once
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// -- direct Rust exports (libtosh_telemetry.a) ------------------------------
+
+// mode word: 0 = off, 1 = token mode, 2 = + per-dispatch metadata.
+// Set once by tosh_tele_init(); read on hot paths with a relaxed atomic load.
+extern _Atomic unsigned int tosh_tele_g_mode;
+
+void     tosh_tele_init(void);
+unsigned tosh_tele_mode(void);
+void     tosh_tele_flush(void);
+uint64_t tosh_tele_uptime_ns(void);
+
+uint64_t tosh_tele_graph_begin(uint32_t device, uint64_t n_nodes);
+void     tosh_tele_graph_end(uint32_t device, uint64_t ordinal, uint64_t n_nodes, uint32_t n_cb, uint32_t flags);
+uint64_t tosh_tele_current_graph(uint32_t device);
+
+void tosh_tele_cb_cpu(uint32_t device, uint64_t graph, uint32_t cb_idx, uint32_t n_cb,
+                      uint64_t t_begin_ns, uint64_t t_end_ns, uint64_t t_commit_ns);
+void tosh_tele_cb_gpu(uint32_t device, uint64_t graph, uint32_t cb_idx,
+                      uint64_t kernel_start_ns, uint64_t kernel_end_ns,
+                      uint64_t gpu_start_ns, uint64_t gpu_end_ns, uint64_t host_done_ns);
+
+uint64_t tosh_tele_name_register(const uint8_t * name, uint32_t name_len);
+void tosh_tele_dispatch(uint32_t device, uint64_t name_hash,
+                        uint64_t tg0, uint64_t tg1, uint64_t tg2,
+                        uint64_t tptg0, uint64_t tptg1, uint64_t tptg2);
+void tosh_tele_blit(uint32_t device, uint32_t kind, uint64_t nbytes, uint32_t dst_device);
+void tosh_tele_ev(uint32_t device, uint32_t kind, uint32_t is_signal, uint64_t value);
+
+void tosh_tele_set_devices_json(const char * json);
+void tosh_tele_manifest_set_field(const char * key, const char * json);
+
+// -- ObjC glue (implemented in ggml-metal-telemetry.m) -----------------------
+
+// map an id<MTLDevice> (as void*) to the ggml device slot it was registered with
+int  tosh_tele_dev_index(const void * mtl_device);
+
+// register a device slot and (once per process) hand the manifest the full
+// device inventory + build stamps; calls tosh_tele_init()
+void tosh_tele_objc_device_init(int slot, void * mtl_device);
+
+// push the CB_GPU record from the Metal completion handler; attach BEFORE
+// commit (macOS 26 asserts on handler registration after commit). The matching
+// CB_CPU record is pushed by the call site right after [cmd_buf commit].
+void tosh_tele_objc_cb_attach(void * cmd_buf, int device, int cb_idx);
+
+// count (mode 1) or record (mode 2) one compute dispatch; name_hash comes
+// from tosh_tele_name_register at pipeline creation (0 = count only)
+void tosh_tele_objc_dispatch(void * encoder, uint64_t name_hash, unsigned mode,
+                             long tg0, long tg1, long tg2,
+                             long tptg0, long tptg1, long tptg2);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/ggml/src/ggml-metal/ggml-metal-telemetry.m b/ggml/src/ggml-metal/ggml-metal-telemetry.m
new file mode 100644
index 000000000..cc94d5862
--- /dev/null
+++ b/ggml/src/ggml-metal/ggml-metal-telemetry.m
@@ -0,0 +1,191 @@
+//
+// ggml-metal-telemetry.m — ObjC glue for the tosh-telemetry staticlib.
+// Added by patches/llama/metal/0055-telemetry.patch; compiled only with
+// GGML_METAL_TELEMETRY=ON and linked against libtosh_telemetry.a.
+//
+
+#import "ggml-metal-telemetry.h"
+
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+
+#import <stdatomic.h>
+#import <stdlib.h>
+#import <string.h>
+#import <stdio.h>
+
+#define TT_STR2(x) #x
+#define TT_STR(x) TT_STR2(x)
+
+// ---------------------------------------------------------------------------
+// device registry: ggml slot <-> MTLDevice. Populated serially during backend
+// registration, then read lock-free on hot paths.
+
+static const void * s_dev_ptr[16];
+static uint64_t     s_dev_reg[16];
+static int          s_dev_slot[16];
+static int          s_dev_n = 0;
+
+int tosh_tele_dev_index(const void * mtl_device) {
+    for (int i = 0; i < s_dev_n; ++i) {
+        if (s_dev_ptr[i] == mtl_device) {
+            return s_dev_slot[i];
+        }
+    }
+    // slow fallback: match by registryID (covers re-fetched device objects)
+    const uint64_t reg = [(id<MTLDevice>) mtl_device registryID];
+    for (int i = 0; i < s_dev_n; ++i) {
+        if (s_dev_reg[i] == reg) {
+            return s_dev_slot[i];
+        }
+    }
+    return 0;
+}
+
+// ---------------------------------------------------------------------------
+// device init hook
+
+void tosh_tele_objc_device_init(int slot, void * mtl_device_raw) {
+    tosh_tele_init(); // idempotent; fixes the mode word
+
+    id<MTLDevice> mtl = (id<MTLDevice>) mtl_device_raw;
+
+    if (s_dev_n < 16) {
+        const uint64_t reg = mtl.registryID;
+        bool seen = false;
+        for (int i = 0; i < s_dev_n; ++i) {
+            if (s_dev_reg[i] == reg && s_dev_slot[i] == slot) {
+                seen = true;
+                break;
+            }
+        }
+        if (!seen) {
+            s_dev_ptr[s_dev_n]  = mtl_device_raw;
+            s_dev_reg[s_dev_n]  = reg;
+            s_dev_slot[s_dev_n] = slot;
+            s_dev_n++;
+        }
+    }
+
+    if (atomic_load_explicit(&tosh_tele_g_mode, memory_order_relaxed) == 0) {
+        return;
+    }
+
+    static bool s_manifest_done = false;
+    if (s_manifest_done) {
+        return;
+    }
+    s_manifest_done = true;
+
+    // full device inventory for the manifest
+    @autoreleasepool {
+        NSArray<id<MTLDevice>> * all = MTLCopyAllDevices();
+        NSMutableString * js = [NSMutableString stringWithString:@"["];
+        NSUInteger i = 0;
+        for (id<MTLDevice> d in all) {
+            int slot_of = -1;
+            for (int k = 0; k < s_dev_n; ++k) {
+                if (s_dev_reg[k] == d.registryID) {
+                    slot_of = s_dev_slot[k];
+                    break;
+                }
+            }
+            if (i++ > 0) {
+                [js appendString:@","];
+            }
+            [js appendFormat:@"{\"name\":\"%s\",\"registryID\":%llu,\"peerGroupID\":%llu,"
+                              "\"peerCount\":%llu,\"recommendedMaxWorkingSetSize\":%llu,"
+                              "\"hasUnifiedMemory\":%s,\"isLowPower\":%s,\"isRemovable\":%s,"
+                              "\"ggml_slot\":%d}",
+                [d.name UTF8String],
+                (unsigned long long) d.registryID,
+                (unsigned long long) d.peerGroupID,
+                (unsigned long long) d.peerCount,
+                (unsigned long long) d.recommendedMaxWorkingSetSize,
+                d.hasUnifiedMemory ? "true" : "false",
+                d.isLowPower ? "true" : "false",
+                d.removable ? "true" : "false",
+                slot_of];
+        }
+        [js appendString:@"]"];
+        tosh_tele_set_devices_json([js UTF8String]);
+        [all release];
+    }
+
+    // backend stamp: the core emits "backend":"unknown" unless glue overrides it
+    tosh_tele_manifest_set_field("backend", "\"metal\"");
+
+    // compile-time build stamps
+    {
+#ifdef TOSH_VERSION
+        const char * tosh_ver = TT_STR(TOSH_VERSION);
+#else
+        const char * tosh_ver = "unknown";
+#endif
+#ifdef TOSH_GIT_COMMIT
+        const char * tosh_commit = TT_STR(TOSH_GIT_COMMIT);
+#else
+        const char * tosh_commit = "unknown";
+#endif
+#ifdef TOSH_GIT_DIRTY
+        const char * tosh_dirty = TT_STR(TOSH_GIT_DIRTY);
+#else
+        const char * tosh_dirty = "0";
+#endif
+#ifdef TOSH_LLAMA_COMMIT
+        const char * llama_commit = TT_STR(TOSH_LLAMA_COMMIT);
+#else
+        const char * llama_commit = "unknown";
+#endif
+        char buf[1024];
+        snprintf(buf, sizeof(buf),
+            "{\"clang\":\"%s\",\"sdk_max\":\"0x%x\",\"deployment_min\":\"0x%x\",\"tosh_version\":\"%s\","
+            "\"toshllm_commit\":\"%s\",\"toshllm_dirty\":%s,\"llama_commit\":\"%s\"}",
+            __clang_version__,
+            (unsigned) __MAC_OS_X_VERSION_MAX_ALLOWED,
+            (unsigned) __MAC_OS_X_VERSION_MIN_REQUIRED,
+            tosh_ver, tosh_commit, tosh_dirty, llama_commit);
+        tosh_tele_manifest_set_field("build", buf);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// command-buffer records
+
+void tosh_tele_objc_cb_attach(void * cmd_buf_raw, int device, int cb_idx) {
+    id<MTLCommandBuffer> cmd_buf = (id<MTLCommandBuffer>) cmd_buf_raw;
+    const uint64_t graph = tosh_tele_current_graph((uint32_t) device);
+
+    // One handler only: kernelStartTime/kernelEndTime are fixed once the CB is
+    // scheduled, so they are safe to read at completion time. This avoids the
+    // scheduled handler's block copy plus the calloc/free stash pair that used
+    // to ferry the two timestamps between handlers. Must still be attached
+    // BEFORE commit (handler registration after commit asserts on macOS 26).
+    [cmd_buf addCompletedHandler:^(id<MTLCommandBuffer> cb) {
+        tosh_tele_cb_gpu((uint32_t) device, graph, (uint32_t) cb_idx,
+                         (uint64_t) (cb.kernelStartTime * 1e9),
+                         (uint64_t) (cb.kernelEndTime   * 1e9),
+                         (uint64_t) (cb.GPUStartTime    * 1e9),
+                         (uint64_t) (cb.GPUEndTime      * 1e9),
+                         tosh_tele_uptime_ns());
+    }];
+}
+
+// ---------------------------------------------------------------------------
+// dispatch hook
+
+void tosh_tele_objc_dispatch(void * encoder_raw, uint64_t name_hash, unsigned mode,
+                             long tg0, long tg1, long tg2,
+                             long tptg0, long tptg1, long tptg2) {
+    id<MTLComputeCommandEncoder> enc = (id<MTLComputeCommandEncoder>) encoder_raw;
+    const int dev = tosh_tele_dev_index(enc.device);
+
+    if (mode < 2) {
+        tosh_tele_dispatch((uint32_t) dev, 0, 0, 0, 0, 0, 0, 0);
+        return;
+    }
+
+    tosh_tele_dispatch((uint32_t) dev, name_hash,
+                       (uint64_t) tg0, (uint64_t) tg1, (uint64_t) tg2,
+                       (uint64_t) tptg0, (uint64_t) tptg1, (uint64_t) tptg2);
+}
